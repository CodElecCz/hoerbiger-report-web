---
import "../styles/global.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hoerbiger Reports Browser</title>
  </head>
  <body>
    <header>
      <div class="header-brand">
        <span class="brand-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h8l4 4v14H6z" />
            <path d="M14 3v4h4M9 12h6M9 16h6" />
          </svg>
        </span>
        <strong>Hoerbiger Reports</strong>
      </div>
      <div class="header-actions">
        <span id="status-text" role="status">Not connected</span>
        <form id="connect-form">
          <input id="password" type="password" placeholder="Password..." aria-label="Password" autocomplete="current-password" required />
          <button id="login-btn" type="submit">Login</button>
        </form>
        <button id="logout-btn" type="button" hidden>Logout</button>
      </div>
    </header>

    <div id="toolbar">
      <div id="breadcrumbs"></div>
      <input id="filter-input" type="text" placeholder="Filter current folder..." disabled />
      <button id="download-selected-btn" hidden>Download Selected (.zip)</button>
      <button id="refresh-btn" disabled>Refresh</button>
    </div>

    <main>
      <div id="browser-pane">
        <div id="list-scroll" tabindex="0">
          <table>
            <colgroup>
              <col style="width: 40px;" />
              <col />
              <col style="width: 90px;" />
              <col style="width: 110px;" />
              <col style="width: 80px;" />
              <col style="width: 56px;" />
            </colgroup>
            <thead>
              <tr>
                <th class="nosort chk"><input type="checkbox" id="select-all" title="Select all" /></th>
                <th data-sort="name">Name</th>
                <th data-sort="size" class="num">Size</th>
                <th data-sort="date">Date</th>
                <th data-sort="time">Time</th>
                <th class="nosort"></th>
              </tr>
            </thead>
            <tbody id="file-list"></tbody>
          </table>
        </div>
      </div>

      <div id="viewer-pane">
        <div id="viewer-header">
          <span id="viewer-title">No file selected</span>
          <button id="viewer-download" hidden>Download</button>
        </div>
        <div id="viewer-body">Log in to browse reports.</div>
      </div>
    </main>

    <footer>
      <span id="summary">&nbsp;</span>
      <span id="hint">↑↓ move · Enter open · Backspace up · Home/End</span>
      <span id="storage-info" role="status"></span>
    </footer>

    <script>
      import {
        loginWithPassword,
        logout,
        getSavedPassword,
        getBucketStats,
        listFolderContents,
        readFileText,
        downloadFile,
        downloadFolderAsZip,
        downloadItemsAsZip,
        type R2Item,
      } from "../lib/r2Browser";

      type SortKey = "name" | "size" | "date" | "time";

      const SVG_OPEN = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">';
      const ICON_FOLDER = `${SVG_OPEN}<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" fill="#fbbf24" stroke="#d97706" stroke-width="1.2"/></svg>`;
      const ICON_UP = `${SVG_OPEN}<path d="M9 14l-4-4 4-4M5 10h9a5 5 0 0 1 5 5v3" stroke="#64748b" stroke-width="2"/></svg>`;
      const ICON_DOWNLOAD = `${SVG_OPEN.replace('width="20" height="20"', 'width="16" height="16"')}<path d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14" stroke="currentColor" stroke-width="2"/></svg>`;
      const fileIcon = (color: string, tag: string) =>
        `${SVG_OPEN}<path d="M6 2h8l5 5v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z" fill="#fff" stroke="${color}" stroke-width="1.5"/><path d="M14 2v5h5" stroke="${color}" stroke-width="1.5"/>${tag}</svg>`;
      const bar = (color: string, y: number, w = 8) => `<path d="M8 ${y}h${w}" stroke="${color}" stroke-width="1.5"/>`;
      const FILE_ICONS: Record<string, string> = {
        pdf: fileIcon("#dc2626", `<path d="M8 15h8v3H8z" fill="#dc2626"/>`),
        csv: fileIcon("#16a34a", bar("#16a34a", 12) + bar("#16a34a", 15) + bar("#16a34a", 18)),
        txt: fileIcon("#64748b", bar("#64748b", 12) + bar("#64748b", 15) + bar("#64748b", 18, 5)),
        html: fileIcon("#2563eb", `<path d="M10 12l-2 2.5 2 2.5M14 12l2 2.5-2 2.5" stroke="#2563eb" stroke-width="1.5"/>`),
        generic: fileIcon("#94a3b8", ""),
      };
      const iconFor = (item: R2Item) => {
        if (item.isFolder) return ICON_FOLDER;
        const ext = item.name.split(".").pop()?.toLowerCase() ?? "";
        return FILE_ICONS[ext === "htm" ? "html" : ext] ?? FILE_ICONS.generic;
      };
      type Row = { up: true } | { up: false; item: R2Item };

      const connectForm = document.getElementById("connect-form") as HTMLFormElement;
      const passwordInput = document.getElementById("password") as HTMLInputElement;
      const loginBtn = document.getElementById("login-btn") as HTMLButtonElement;
      const logoutBtn = document.getElementById("logout-btn") as HTMLButtonElement;
      const statusText = document.getElementById("status-text")!;
      const breadcrumbsEl = document.getElementById("breadcrumbs")!;
      const filterInput = document.getElementById("filter-input") as HTMLInputElement;
      const refreshBtn = document.getElementById("refresh-btn") as HTMLButtonElement;
      const downloadSelectedBtn = document.getElementById("download-selected-btn") as HTMLButtonElement;
      const selectAll = document.getElementById("select-all") as HTMLInputElement;
      const listScroll = document.getElementById("list-scroll")!;
      const fileListEl = document.getElementById("file-list")!;
      const viewerTitle = document.getElementById("viewer-title")!;
      const viewerDownloadBtn = document.getElementById("viewer-download") as HTMLButtonElement;
      let currentFile: R2Item | null = null;
      const viewerBody = document.getElementById("viewer-body")!;
      const summaryEl = document.getElementById("summary")!;
      const storageInfo = document.getElementById("storage-info")!;

      let folderStack: { prefix: string; name: string }[] = [{ prefix: "", name: "Reports" }];
      let currentItems: R2Item[] = [];
      let rows: Row[] = [];
      let cursor = 0;
      let sortKey: SortKey = "name";
      let sortDir: 1 | -1 = -1;
      let selectedId: string | null = null;
      const checked = new Set<string>();
      let connected = false;
      let requestVersion = 0;
      let previewVersion = 0;
      let statsVersion = 0;

      function formatSize(bytes: number): string {
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
        if (bytes < 1024 ** 3) return `${(bytes / 1024 ** 2).toFixed(1)} MB`;
        return `${(bytes / 1024 ** 3).toFixed(2)} GB`;
      }

      async function loadBucketStats() {
        const version = ++statsVersion;
        storageInfo.textContent = "Loading storage...";
        try {
          const { totalBytes, totalFiles, limitBytes } = await getBucketStats();
          if (version !== statsVersion) return;
          const freeBytes = Math.max(limitBytes - totalBytes, 0);
          storageInfo.textContent = `Storage: ${formatSize(totalBytes)} / ${formatSize(limitBytes)} used (${formatSize(freeBytes)} free) • ${totalFiles.toLocaleString()} files`;
        } catch (err) {
          if (version === statsVersion) storageInfo.textContent = `Storage unavailable: ${errorMessage(err)}`;
        }
      }

      function compare(a: R2Item, b: R2Item): number {
        if (a.isFolder !== b.isFolder) return a.isFolder ? -1 : 1;
        let r = 0;
        switch (sortKey) {
          case "size":
            r = Number(a.size ?? 0) - Number(b.size ?? 0);
            break;
          case "date":
          case "time": {
            const ta = a.modifiedTime?.getTime() ?? 0;
            const tb = b.modifiedTime?.getTime() ?? 0;
            r = sortKey === "date" ? ta - tb : (ta % 86400000) - (tb % 86400000);
            break;
          }
          default:
            r = 0;
        }
        if (r === 0) r = a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: "base" });
        return r * sortDir;
      }

      function renderBreadcrumbs() {
        breadcrumbsEl.innerHTML = "";
        folderStack.forEach((crumb, idx) => {
          if (idx > 0) {
            const sep = document.createElement("span");
            sep.textContent = "/";
            breadcrumbsEl.appendChild(sep);
          }
          const btn = document.createElement("button");
          btn.className = "crumb";
          btn.textContent = crumb.name;
          if (idx < folderStack.length - 1) {
            btn.onclick = () => {
              folderStack = folderStack.slice(0, idx + 1);
              loadCurrentFolder();
            };
          }
          breadcrumbsEl.appendChild(btn);
        });
      }

      function cell(text: string, cls = ""): HTMLTableCellElement {
        const td = document.createElement("td");
        td.textContent = text;
        if (cls) td.className = cls;
        td.title = text;
        return td;
      }

      function renderTable() {
        const needle = filterInput.value.trim().toLowerCase();
        const visible = (needle
          ? currentItems.filter((i) => i.name.toLowerCase().includes(needle))
          : [...currentItems]
        ).sort(compare);

        rows = [];
        if (folderStack.length > 1) rows.push({ up: true });
        for (const item of visible) rows.push({ up: false, item });
        cursor = Math.min(Math.max(cursor, 0), Math.max(rows.length - 1, 0));

        fileListEl.innerHTML = "";
        rows.forEach((row, idx) => {
          const tr = document.createElement("tr");
          const classes: string[] = [];
          if (idx === cursor) classes.push("cursor");
          if (!row.up && row.item.key === selectedId) classes.push("selected");
          tr.className = classes.join(" ");

          const nameTd = document.createElement("td");
          nameTd.className = row.up || row.item.isFolder ? "name dir" : "name";
          const label = document.createElement("span");
          label.className = "label";
          label.textContent = row.up ? ".." : row.item.name;
          nameTd.title = label.textContent;
          nameTd.insertAdjacentHTML("afterbegin", row.up ? ICON_UP : iconFor(row.item));
          nameTd.appendChild(label);

          const actionTd = document.createElement("td");
          actionTd.className = "num";
          const chkTd = document.createElement("td");
          chkTd.className = "chk";
          chkTd.onclick = (e) => e.stopPropagation();
          if (row.up) {
            tr.append(chkTd, nameTd, cell("", "num"), cell(""), cell(""), actionTd);
          } else {
            const { item } = row;
            const d = item.modifiedTime;
            const chk = document.createElement("input");
            chk.type = "checkbox";
            chk.checked = checked.has(item.key);
            chk.setAttribute("aria-label", `Select ${item.name}`);
            chk.onchange = () => {
              if (chk.checked) checked.add(item.key);
              else checked.delete(item.key);
              updateSelectionUI();
            };
            chkTd.appendChild(chk);

            const btn = document.createElement("button");
            btn.className = "dl-btn";
            btn.title = item.isFolder ? `Download ${item.name} as .zip` : `Download ${item.name}`;
            btn.setAttribute("aria-label", btn.title);
            btn.innerHTML = ICON_DOWNLOAD;
            btn.onclick = async (e) => {
              e.stopPropagation();
              btn.disabled = true;
              try {
                if (item.isFolder) {
                  await downloadFolderAsZip(item.key, item.name, (msg) => (statusText.textContent = msg));
                } else {
                  await downloadItem(item);
                }
              } catch (err) {
                statusText.textContent = `Download failed: ${errorMessage(err)}`;
              } finally {
                btn.disabled = false;
              }
            };
            actionTd.appendChild(btn);
            tr.append(
              chkTd,
              nameTd,
              cell(item.isFolder ? "" : formatSize(Number(item.size ?? 0)), "num"),
              cell(d ? d.toLocaleDateString(undefined, { year: "numeric", month: "2-digit", day: "2-digit" }) : ""),
              cell(d ? d.toLocaleTimeString(undefined, { hour: "2-digit", minute: "2-digit" }) : ""),
              actionTd,
            );
          }

          tr.onclick = () => {
            setCursor(idx);
            openRow(idx);
          };
          fileListEl.appendChild(tr);
        });

        document.querySelectorAll<HTMLElement>("th[data-sort]").forEach((th) => {
          const label = th.dataset.label ?? (th.dataset.label = th.textContent ?? "");
          th.textContent = th.dataset.sort === sortKey ? `${label} ${sortDir === 1 ? "▲" : "▼"}` : label;
        });

        renderSummary(visible);
        updateSelectionUI();
      }

      function updateSelectionUI() {
        const visibleIds = rows.filter((r): r is { up: false; item: R2Item } => !r.up).map((r) => r.item.key);
        const n = visibleIds.filter((id) => checked.has(id)).length;
        selectAll.checked = visibleIds.length > 0 && n === visibleIds.length;
        selectAll.indeterminate = n > 0 && n < visibleIds.length;
        const total = checked.size;
        downloadSelectedBtn.hidden = total === 0;
        if (!downloadSelectedBtn.disabled) downloadSelectedBtn.textContent = `Download Selected (.zip) · ${total}`;
      }

      selectAll.onclick = (e) => e.stopPropagation();
      selectAll.onchange = () => {
        for (const row of rows) {
          if (row.up) continue;
          if (selectAll.checked) checked.add(row.item.key);
          else checked.delete(row.item.key);
        }
        renderTable();
      };

      downloadSelectedBtn.onclick = async () => {
        const items = currentItems.filter((i) => checked.has(i.key));
        if (!items.length) return;
        downloadSelectedBtn.disabled = true;
        try {
          await downloadItemsAsZip(items, "Reports-selection", (msg) => (statusText.textContent = msg));
        } catch (err) {
          statusText.textContent = `Download failed: ${errorMessage(err)}`;
        } finally {
          downloadSelectedBtn.disabled = false;
          updateSelectionUI();
        }
      };

      function renderSummary(visible: R2Item[]) {
        const folders = visible.filter((i) => i.isFolder).length;
        const files = visible.filter((i) => !i.isFolder);
        const total = files.reduce((sum, f) => sum + Number(f.size ?? 0), 0);
        const row = rows[cursor];
        const sel = row && !row.up ? `${row.item.name}  |  ` : "";
        summaryEl.textContent = `${sel}${formatSize(total)} in ${files.length} file(s), ${folders} folder(s)`;
      }

      function setCursor(idx: number) {
        if (!rows.length) return;
        cursor = Math.min(Math.max(idx, 0), rows.length - 1);
        const trs = fileListEl.children;
        for (let i = 0; i < trs.length; i++) trs[i].classList.toggle("cursor", i === cursor);
        (trs[cursor] as HTMLElement | undefined)?.scrollIntoView({ block: "nearest" });
        renderSummary(rows.filter((r): r is { up: false; item: R2Item } => !r.up).map((r) => r.item));
      }

      function goUp() {
        if (folderStack.length > 1) {
          folderStack.pop();
          cursor = 0;
          loadCurrentFolder();
        }
      }

      function openRow(idx: number) {
        const row = rows[idx];
        if (!row) return;
        if (row.up) return goUp();
        if (row.item.isFolder) {
          folderStack.push({ prefix: row.item.key, name: row.item.name });
          cursor = 0;
          loadCurrentFolder();
        } else {
          openFile(row.item);
        }
      }

      async function loadCurrentFolder() {
        if (!connected) return;
        const version = ++requestVersion;
        const current = folderStack[folderStack.length - 1];
        renderBreadcrumbs();
        checked.clear();
        currentItems = [];
        renderTable();
        statusText.textContent = `Loading ${current.name}...`;
        try {
          const items = await listFolderContents(current.prefix);
          if (version !== requestVersion) return;
          currentItems = items;
          renderTable();
          statusText.textContent = `${currentItems.length} item(s)`;
        } catch (err) {
          if (version !== requestVersion) return;
          currentItems = [];
          renderTable();
          statusText.textContent = `Error loading folder: ${errorMessage(err)}`;
        }
      }

      async function downloadItem(item: R2Item) {
        statusText.textContent = `Downloading ${item.name}...`;
        await downloadFile(item.key, item.name);
        statusText.textContent = `Downloaded ${item.name}`;
      }

      async function openFile(item: R2Item) {
        const version = ++previewVersion;
        selectedId = item.key;
        for (const [i, tr] of Array.from(fileListEl.children).entries()) {
          const r = rows[i];
          tr.classList.toggle("selected", !!r && !r.up && r.item.key === item.key);
        }
        currentFile = item;
        viewerTitle.textContent = item.name;
        viewerDownloadBtn.hidden = false;
        viewerBody.textContent = "Downloading file...";
        try {
          const content = await readFileText(item.key);
          if (version !== previewVersion) return;
          if (item.name.toLowerCase().endsWith(".html")) {
            const iframe = document.createElement("iframe");
            iframe.setAttribute("sandbox", "allow-scripts");
            iframe.srcdoc = content;
            viewerBody.innerHTML = "";
            viewerBody.appendChild(iframe);
          } else {
            const pre = document.createElement("pre");
            pre.textContent = content;
            viewerBody.innerHTML = "";
            viewerBody.appendChild(pre);
          }
        } catch (err) {
          if (version === previewVersion) viewerBody.textContent = `Failed to load file: ${errorMessage(err)}`;
        }
      }

      function errorMessage(err: unknown): string {
        return err instanceof Error ? err.message : String(err);
      }

      listScroll.addEventListener("keydown", (e) => {
        const page = Math.max(Math.floor(listScroll.clientHeight / 22) - 1, 1);
        const handlers: Record<string, () => void> = {
          ArrowDown: () => setCursor(cursor + 1),
          ArrowUp: () => setCursor(cursor - 1),
          PageDown: () => setCursor(cursor + page),
          PageUp: () => setCursor(cursor - page),
          Home: () => setCursor(0),
          End: () => setCursor(rows.length - 1),
          Enter: () => openRow(cursor),
          Backspace: goUp,
        };
        const handler = handlers[e.key];
        if (handler) {
          e.preventDefault();
          handler();
        }
      });

      document.querySelectorAll<HTMLElement>("th[data-sort]").forEach((th) => {
        th.onclick = () => {
          const key = th.dataset.sort as SortKey;
          if (sortKey === key) sortDir = sortDir === 1 ? -1 : 1;
          else {
            sortKey = key;
            sortDir = 1;
          }
          renderTable();
        };
      });

      async function connect(password: string) {
        loginBtn.disabled = true;
        statusText.textContent = "Logging in...";
        try {
          await loginWithPassword(password);
          connected = true;
          connectForm.hidden = true;
          logoutBtn.hidden = false;
          passwordInput.value = "";
          filterInput.disabled = false;
          refreshBtn.disabled = false;
          viewerBody.textContent = "Select a file from the list to preview or download.";
          void loadBucketStats();
          await loadCurrentFolder();
          if (connected) listScroll.focus();
        } catch (err) {
          statusText.textContent = `Login failed: ${errorMessage(err)}`;
        } finally {
          loginBtn.disabled = false;
        }
      }

      connectForm.onsubmit = (event) => {
        event.preventDefault();
        void connect(passwordInput.value);
      };

      logoutBtn.onclick = () => {
        try {
          logout();
        } catch (err) {
          statusText.textContent = `Could not clear password: ${errorMessage(err)}`;
          return;
        }
        connected = false;
        requestVersion++;
        previewVersion++;
        statsVersion++;
        storageInfo.textContent = "";
        folderStack = [{ prefix: "", name: "Reports" }];
        currentItems = [];
        checked.clear();
        selectedId = null;
        currentFile = null;
        cursor = 0;
        filterInput.value = "";
        filterInput.disabled = true;
        refreshBtn.disabled = true;
        viewerDownloadBtn.hidden = true;
        viewerTitle.textContent = "No file selected";
        viewerBody.textContent = "Log in to browse reports.";
        connectForm.hidden = false;
        logoutBtn.hidden = true;
        passwordInput.value = "";
        renderBreadcrumbs();
        renderTable();
        statusText.textContent = "Not connected";
      };

      viewerDownloadBtn.onclick = async () => {
        if (!currentFile) return;
        try {
          await downloadItem(currentFile);
        } catch (err) {
          statusText.textContent = `Download failed: ${errorMessage(err)}`;
        }
      };

      filterInput.oninput = () => {
        cursor = 0;
        renderTable();
      };
      refreshBtn.onclick = () => {
        loadCurrentFolder();
        void loadBucketStats();
      };

      renderBreadcrumbs();
      try {
        const saved = getSavedPassword();
        if (saved !== null) void connect(saved);
      } catch (err) {
        statusText.textContent = `Could not read saved password: ${errorMessage(err)}`;
      }
    </script>
  </body>
</html>
