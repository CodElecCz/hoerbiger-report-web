---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hoerbiger Reports Browser</title>
    <style>
      * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }
      body { margin: 0; display: flex; flex-direction: column; height: 100vh; color: #1e293b; }
      header { display: flex; gap: 12px; align-items: center; padding: 8px 16px; background: #0f172a; color: #fff; }
      header button, #refresh-btn { padding: 5px 12px; border-radius: 4px; border: none; background: #2563eb; color: #fff; cursor: pointer; font-weight: 500; }
      header button:disabled, #refresh-btn:disabled { background: #475569; cursor: default; }
      #toolbar { display: flex; gap: 10px; align-items: center; padding: 6px 16px; background: #f1f5f9; border-bottom: 1px solid #cbd5e1; }
      #breadcrumbs { display: flex; gap: 4px; align-items: center; flex: 1; font-size: 13px; flex-wrap: wrap; font-family: Consolas, monospace; }
      #breadcrumbs span { color: #64748b; }
      .crumb { color: #2563eb; cursor: pointer; background: none; border: none; padding: 0; font-size: 13px; font-family: Consolas, monospace; }
      .crumb:hover { text-decoration: underline; }
      .crumb:last-child { color: #0f172a; font-weight: 600; cursor: default; text-decoration: none; }
      #filter-input { padding: 4px 10px; border: 1px solid #94a3b8; border-radius: 4px; width: 220px; }
      main { display: flex; flex: 1; overflow: hidden; }
      #browser-pane { width: 48%; min-width: 420px; display: flex; flex-direction: column; border-right: 1px solid #cbd5e1; }
      #list-scroll { flex: 1; overflow: auto; outline: none; }
      table { width: 100%; border-collapse: collapse; font-size: 13px; font-family: Consolas, monospace; table-layout: fixed; }
      table { font-family: system-ui, -apple-system, sans-serif; }
      th, td { padding: 10px 14px; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-bottom: 1px solid #e2e8f0; }
      th { background: #f8fafc; position: sticky; top: 0; z-index: 1; cursor: pointer; user-select: none; font-weight: 600; color: #475569; }
      th:hover { background: #e2e8f0; }
      th.num, td.num { text-align: right; }
      th.nosort { cursor: default; }
      th.nosort:hover { background: #f8fafc; }
      td.name { display: flex; align-items: center; gap: 10px; }
      td.name .label { overflow: hidden; text-overflow: ellipsis; }
      td.dir .label { font-weight: 700; color: #0f172a; }
      td svg { flex: none; width: 20px; height: 20px; }
      tbody tr { cursor: pointer; user-select: none; transition: background 0.12s; }
      tbody tr:hover { background: #f1f5f9; }
      tbody tr.selected, tbody tr.cursor { background: #e0f2fe; }
      tbody tr.selected td:first-child, tbody tr.cursor td:first-child { box-shadow: inset 3px 0 0 #2563eb; }
      .dl-btn { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border: none; border-radius: 6px; background: transparent; color: #475569; cursor: pointer; }
      .dl-btn:hover { background: #bfdbfe; color: #1d4ed8; }
      .dl-btn svg { width: 16px; height: 16px; }
      #viewer-pane { flex: 1; display: flex; flex-direction: column; overflow: hidden; padding: 10px 16px; }
      #viewer-header { font-weight: 600; margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px solid #e2e8f0; }
      #viewer-body { flex: 1; overflow: auto; }
      pre { margin: 0; font-family: Consolas, monospace; font-size: 12px; white-space: pre-wrap; }
      iframe { width: 100%; height: 100%; border: none; }
      footer { display: flex; justify-content: space-between; gap: 16px; padding: 4px 16px; background: #0f172a; color: #cbd5e1; font-size: 12px; font-family: Consolas, monospace; }
      #hint { color: #94a3b8; font-size: 11px; font-family: system-ui, sans-serif; }
    </style>
  </head>
  <body>
    <header>
      <strong>Hoerbiger Reports</strong>
      <button id="login-btn">Sign in with Google</button>
      <span id="status-text" style="font-size: 13px; color: #94a3b8;">Not connected</span>
    </header>

    <div id="toolbar">
      <div id="breadcrumbs"></div>
      <input id="filter-input" type="text" placeholder="Filter current folder..." disabled />
      <button id="refresh-btn" disabled>Refresh</button>
    </div>

    <main>
      <div id="browser-pane">
        <div id="list-scroll" tabindex="0">
          <table>
            <colgroup>
              <col />
              <col style="width: 90px;" />
              <col style="width: 110px;" />
              <col style="width: 80px;" />
              <col style="width: 56px;" />
            </colgroup>
            <thead>
              <tr>
                <th data-sort="name">Name</th>
                <th data-sort="size" class="num">Size</th>
                <th data-sort="date">Date</th>
                <th data-sort="time">Time</th>
                <th class="nosort"></th>
              </tr>
            </thead>
            <tbody id="file-list"></tbody>
          </table>
        </div>
      </div>

      <div id="viewer-pane">
        <div id="viewer-header">No file selected</div>
        <div id="viewer-body">Sign in with Google to browse your shared Reports folder.</div>
      </div>
    </main>

    <footer>
      <span id="summary">&nbsp;</span>
      <span id="hint">↑↓ move · Enter open · Backspace up · Home/End</span>
      <span id="free-space">Free: -</span>
    </footer>

    <script>
      import {
        ROOT_FOLDER_ID,
        signInWithGoogle,
        listFolderContents,
        readFileText,
        getStorageInfo,
        downloadFile,
        type DriveItem,
      } from "../lib/driveBrowser";

      type SortKey = "name" | "size" | "date" | "time";

      const SVG_OPEN = '<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">';
      const ICON_FOLDER = `${SVG_OPEN}<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" fill="#fbbf24" stroke="#d97706" stroke-width="1.2"/></svg>`;
      const ICON_UP = `${SVG_OPEN}<path d="M9 14l-4-4 4-4M5 10h9a5 5 0 0 1 5 5v3" stroke="#64748b" stroke-width="2"/></svg>`;
      const ICON_DOWNLOAD = `${SVG_OPEN}<path d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14" stroke="currentColor" stroke-width="2"/></svg>`;
      const fileIcon = (color: string, tag: string) =>
        `${SVG_OPEN}<path d="M6 2h8l5 5v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z" fill="#fff" stroke="${color}" stroke-width="1.5"/><path d="M14 2v5h5" stroke="${color}" stroke-width="1.5"/>${tag}</svg>`;
      const bar = (color: string, y: number, w = 8) => `<path d="M8 ${y}h${w}" stroke="${color}" stroke-width="1.5"/>`;
      const FILE_ICONS: Record<string, string> = {
        pdf: fileIcon("#dc2626", `<path d="M8 15h8v3H8z" fill="#dc2626"/>`),
        csv: fileIcon("#16a34a", bar("#16a34a", 12) + bar("#16a34a", 15) + bar("#16a34a", 18)),
        txt: fileIcon("#64748b", bar("#64748b", 12) + bar("#64748b", 15) + bar("#64748b", 18, 5)),
        html: fileIcon("#2563eb", `<path d="M10 12l-2 2.5 2 2.5M14 12l2 2.5-2 2.5" stroke="#2563eb" stroke-width="1.5"/>`),
        generic: fileIcon("#94a3b8", ""),
      };
      const iconFor = (item: DriveItem) => {
        if (item.isFolder) return ICON_FOLDER;
        const ext = item.name.split(".").pop()?.toLowerCase() ?? "";
        return FILE_ICONS[ext === "htm" ? "html" : ext] ?? FILE_ICONS.generic;
      };
      type Row = { up: true } | { up: false; item: DriveItem };

      const loginBtn = document.getElementById("login-btn") as HTMLButtonElement;
      const statusText = document.getElementById("status-text")!;
      const breadcrumbsEl = document.getElementById("breadcrumbs")!;
      const filterInput = document.getElementById("filter-input") as HTMLInputElement;
      const refreshBtn = document.getElementById("refresh-btn") as HTMLButtonElement;
      const listScroll = document.getElementById("list-scroll")!;
      const fileListEl = document.getElementById("file-list")!;
      const viewerHeader = document.getElementById("viewer-header")!;
      const viewerBody = document.getElementById("viewer-body")!;
      const summaryEl = document.getElementById("summary")!;
      const freeSpaceEl = document.getElementById("free-space")!;

      let folderStack: { id: string; name: string }[] = [{ id: ROOT_FOLDER_ID, name: "Reports" }];
      let currentItems: DriveItem[] = [];
      let rows: Row[] = [];
      let cursor = 0;
      let sortKey: SortKey = "name";
      let sortDir: 1 | -1 = -1;
      let selectedId: string | null = null;

      function formatSize(bytes: number): string {
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
        if (bytes < 1024 ** 3) return `${(bytes / 1024 ** 2).toFixed(1)} MB`;
        return `${(bytes / 1024 ** 3).toFixed(2)} GB`;
      }

      function compare(a: DriveItem, b: DriveItem): number {
        if (a.isFolder !== b.isFolder) return a.isFolder ? -1 : 1;
        let r = 0;
        switch (sortKey) {
          case "size":
            r = Number(a.size ?? 0) - Number(b.size ?? 0);
            break;
          case "date":
          case "time": {
            const ta = new Date(a.modifiedTime).getTime();
            const tb = new Date(b.modifiedTime).getTime();
            r = sortKey === "date" ? ta - tb : (ta % 86400000) - (tb % 86400000);
            break;
          }
          default:
            r = 0;
        }
        if (r === 0) r = a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: "base" });
        return r * sortDir;
      }

      function renderBreadcrumbs() {
        breadcrumbsEl.innerHTML = "";
        folderStack.forEach((crumb, idx) => {
          if (idx > 0) {
            const sep = document.createElement("span");
            sep.textContent = "/";
            breadcrumbsEl.appendChild(sep);
          }
          const btn = document.createElement("button");
          btn.className = "crumb";
          btn.textContent = crumb.name;
          if (idx < folderStack.length - 1) {
            btn.onclick = () => {
              folderStack = folderStack.slice(0, idx + 1);
              loadCurrentFolder();
            };
          }
          breadcrumbsEl.appendChild(btn);
        });
      }

      function cell(text: string, cls = ""): HTMLTableCellElement {
        const td = document.createElement("td");
        td.textContent = text;
        if (cls) td.className = cls;
        td.title = text;
        return td;
      }

      function renderTable() {
        const needle = filterInput.value.trim().toLowerCase();
        const visible = (needle
          ? currentItems.filter((i) => i.name.toLowerCase().includes(needle))
          : [...currentItems]
        ).sort(compare);

        rows = [];
        if (folderStack.length > 1) rows.push({ up: true });
        for (const item of visible) rows.push({ up: false, item });
        cursor = Math.min(Math.max(cursor, 0), Math.max(rows.length - 1, 0));

        fileListEl.innerHTML = "";
        rows.forEach((row, idx) => {
          const tr = document.createElement("tr");
          const classes: string[] = [];
          if (idx === cursor) classes.push("cursor");
          if (!row.up && row.item.id === selectedId) classes.push("selected");
          tr.className = classes.join(" ");

          const nameTd = document.createElement("td");
          nameTd.className = row.up || row.item.isFolder ? "name dir" : "name";
          const label = document.createElement("span");
          label.className = "label";
          label.textContent = row.up ? ".." : row.item.name;
          nameTd.title = label.textContent;
          nameTd.insertAdjacentHTML("afterbegin", row.up ? ICON_UP : iconFor(row.item));
          nameTd.appendChild(label);

          const actionTd = document.createElement("td");
          actionTd.className = "num";
          if (row.up) {
            tr.append(nameTd, cell("", "num"), cell(""), cell(""), actionTd);
          } else {
            const { item } = row;
            const d = new Date(item.modifiedTime);
            if (!item.isFolder) {
              const btn = document.createElement("button");
              btn.className = "dl-btn";
              btn.title = `Download ${item.name}`;
              btn.setAttribute("aria-label", `Download ${item.name}`);
              btn.innerHTML = ICON_DOWNLOAD;
              btn.onclick = (e) => {
                e.stopPropagation();
                downloadItem(item);
              };
              actionTd.appendChild(btn);
            }
            tr.append(
              nameTd,
              cell(item.isFolder ? "" : formatSize(Number(item.size ?? 0)), "num"),
              cell(d.toLocaleDateString(undefined, { year: "numeric", month: "2-digit", day: "2-digit" })),
              cell(d.toLocaleTimeString(undefined, { hour: "2-digit", minute: "2-digit" })),
              actionTd,
            );
          }

          tr.onclick = () => {
            setCursor(idx);
            openRow(idx);
          };
          fileListEl.appendChild(tr);
        });

        document.querySelectorAll<HTMLElement>("th[data-sort]").forEach((th) => {
          const label = th.dataset.label ?? (th.dataset.label = th.textContent ?? "");
          th.textContent = th.dataset.sort === sortKey ? `${label} ${sortDir === 1 ? "▲" : "▼"}` : label;
        });

        renderSummary(visible);
      }

      function renderSummary(visible: DriveItem[]) {
        const folders = visible.filter((i) => i.isFolder).length;
        const files = visible.filter((i) => !i.isFolder);
        const total = files.reduce((sum, f) => sum + Number(f.size ?? 0), 0);
        const row = rows[cursor];
        const sel = row && !row.up ? `${row.item.name}  |  ` : "";
        summaryEl.textContent = `${sel}${formatSize(total)} in ${files.length} file(s), ${folders} folder(s)`;
      }

      function setCursor(idx: number) {
        if (!rows.length) return;
        cursor = Math.min(Math.max(idx, 0), rows.length - 1);
        const trs = fileListEl.children;
        for (let i = 0; i < trs.length; i++) trs[i].classList.toggle("cursor", i === cursor);
        (trs[cursor] as HTMLElement | undefined)?.scrollIntoView({ block: "nearest" });
        renderSummary(rows.filter((r): r is { up: false; item: DriveItem } => !r.up).map((r) => r.item));
      }

      function goUp() {
        if (folderStack.length > 1) {
          folderStack.pop();
          cursor = 0;
          loadCurrentFolder();
        }
      }

      function openRow(idx: number) {
        const row = rows[idx];
        if (!row) return;
        if (row.up) return goUp();
        if (row.item.isFolder) {
          folderStack.push({ id: row.item.id, name: row.item.name });
          cursor = 0;
          loadCurrentFolder();
        } else {
          openFile(row.item);
        }
      }

      async function loadCurrentFolder() {
        const current = folderStack[folderStack.length - 1];
        renderBreadcrumbs();
        statusText.textContent = `Loading ${current.name}...`;
        try {
          currentItems = await listFolderContents(current.id);
          renderTable();
          statusText.textContent = `${currentItems.length} item(s)`;
        } catch (err: any) {
          statusText.textContent = "Error loading folder";
          viewerBody.textContent = err.message;
        }
      }

      async function downloadItem(item: DriveItem) {
        statusText.textContent = `Downloading ${item.name}...`;
        try {
          await downloadFile(item.id, item.name);
          statusText.textContent = `Downloaded ${item.name}`;
        } catch (err: any) {
          statusText.textContent = "Download failed";
          console.error(err);
        }
      }

      async function openFile(item: DriveItem) {
        selectedId = item.id;
        for (const [i, tr] of Array.from(fileListEl.children).entries()) {
          const r = rows[i];
          tr.classList.toggle("selected", !!r && !r.up && r.item.id === item.id);
        }
        viewerHeader.textContent = item.name;
        viewerBody.textContent = "Downloading file...";
        try {
          const content = await readFileText(item.id);
          if (item.name.toLowerCase().endsWith(".html")) {
            const iframe = document.createElement("iframe");
            iframe.srcdoc = content;
            viewerBody.innerHTML = "";
            viewerBody.appendChild(iframe);
          } else {
            const pre = document.createElement("pre");
            pre.textContent = content;
            viewerBody.innerHTML = "";
            viewerBody.appendChild(pre);
          }
        } catch (err: any) {
          viewerBody.textContent = `Failed to load file: ${err.message}`;
        }
      }

      async function loadFreeSpace() {
        try {
          const { used, limit } = await getStorageInfo();
          freeSpaceEl.textContent =
            limit === null
              ? `Free: unlimited (${formatSize(used)} used)`
              : `Free: ${formatSize(Math.max(limit - used, 0))} of ${formatSize(limit)}`;
        } catch {
          freeSpaceEl.textContent = "Free: n/a";
        }
      }

      listScroll.addEventListener("keydown", (e) => {
        const page = Math.max(Math.floor(listScroll.clientHeight / 22) - 1, 1);
        const handlers: Record<string, () => void> = {
          ArrowDown: () => setCursor(cursor + 1),
          ArrowUp: () => setCursor(cursor - 1),
          PageDown: () => setCursor(cursor + page),
          PageUp: () => setCursor(cursor - page),
          Home: () => setCursor(0),
          End: () => setCursor(rows.length - 1),
          Enter: () => openRow(cursor),
          Backspace: goUp,
        };
        const handler = handlers[e.key];
        if (handler) {
          e.preventDefault();
          handler();
        }
      });

      document.querySelectorAll<HTMLElement>("th[data-sort]").forEach((th) => {
        th.onclick = () => {
          const key = th.dataset.sort as SortKey;
          if (sortKey === key) sortDir = sortDir === 1 ? -1 : 1;
          else {
            sortKey = key;
            sortDir = 1;
          }
          renderTable();
        };
      });

      loginBtn.onclick = async () => {
        try {
          await signInWithGoogle();
          loginBtn.textContent = "Connected";
          loginBtn.disabled = true;
          filterInput.disabled = false;
          refreshBtn.disabled = false;
          viewerBody.textContent = "Select a file from the list to preview or download.";
          await loadCurrentFolder();
          listScroll.focus();
          loadFreeSpace();
        } catch (err: any) {
          statusText.textContent = "Sign-in failed";
          console.error(err);
        }
      };

      filterInput.oninput = () => {
        cursor = 0;
        renderTable();
      };
      refreshBtn.onclick = () => {
        loadCurrentFolder();
        loadFreeSpace();
      };
    </script>
  </body>
</html>
